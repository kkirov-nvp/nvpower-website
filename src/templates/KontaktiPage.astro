---
import { Phone, Mail, Clock, MapPin, ArrowRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import ContactForm from "../islands/ContactForm";
import type { Locale } from "../config/site";
import { site } from "../config/site";
import { r } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const c = {
  bg: {
    title: "Контакти — NV Power",
    description: `Свържи се с NV Power: телефон, имейл, Viber и WhatsApp. Отговаряме до 3 работни дни в работно време.`,
    h1: "Да поговорим за твоята енергия",
    sub: "Избери канала, който ти е удобен — отговаряме бързо и по същество.",
    channels: { phone: "Обади се", email: "Пиши ни", viber: "Viber", whatsapp: "WhatsApp", hours: "Работно време" },
    formTitle: "Или ни изпрати запитване",
    addressTitle: "Къде да ни намериш",
    crossSell: "Предпочиташ директно оферта с конкретни числа?",
    crossCta: "Вземи оферта за 2 минути",
  },
  en: {
    title: "Contact — NV Power",
    description: `Reach NV Power by phone, email, Viber or WhatsApp. We reply within 3 business days during business hours.`,
    h1: "Let's talk about your energy",
    sub: "Pick whichever channel suits you — we reply fast and to the point.",
    channels: { phone: "Call us", email: "Email us", viber: "Viber", whatsapp: "WhatsApp", hours: "Working hours" },
    formTitle: "Or send us an enquiry",
    addressTitle: "Where to find us",
    crossSell: "Prefer a quote with real numbers right away?",
    crossCta: "Get a quote in 2 minutes",
  },
}[locale];

const waNumber = site.phoneHref.replace("+", "");

const channels = [
  { icon: Phone, label: c.channels.phone, value: site.phone, href: `tel:${site.phoneHref}` },
  { icon: Mail, label: c.channels.email, value: site.email, href: `mailto:${site.email}` },
  { icon: null, brand: "viber", label: c.channels.viber, value: site.phone, href: `viber://chat?number=%2B${waNumber}` },
  { icon: null, brand: "whatsapp", label: c.channels.whatsapp, value: site.phone, href: `https://wa.me/${waNumber}` },
  { icon: Clock, label: c.channels.hours, value: site.workingHours[locale], href: null },
];
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/kontakti/">
  <section class="bg-surface-alt border-b border-line">
    <div class="container-site py-14 text-center md:py-18">
      <h1 class="text-3xl font-bold text-body md:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-xl text-muted md:text-lg">{c.sub}</p>
    </div>
  </section>

  <!-- direct channels grid -->
  <section class="container-site -mt-8 pb-4">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {channels.map((ch, i) => {
        const Inner = (
          <>
            {ch.icon ? (
              <ch.icon class="size-6 text-accent" aria-hidden="true" />
            ) : ch.brand === "viber" ? (
              <svg viewBox="0 0 24 24" class="size-6 text-[#7360f2]" fill="currentColor" aria-hidden="true"><path d="M12 .9C9.4.9 4.9 1.3 2.6 3.5.9 5.1.4 7.6.4 10.6c0 2.9.4 5.5 2.2 7.2.7.7 1.6 1.2 2.6 1.5v3.1c0 .5.6.8 1 .5l2.6-2.4c1.1.1 2.1.2 3.2.2 2.6 0 7.1-.4 9.4-2.6 1.7-1.7 2.2-4.1 2.2-7.1s-.5-5.5-2.2-7.1C19.1 1.3 14.6.9 12 .9Zm4.9 14.6c-.3.7-1.4 1.4-2.1 1.5-.6.1-1.3.2-3.8-.9-2.9-1.3-4.8-4.3-4.9-4.5-.1-.2-1.2-1.6-1.2-3.1S5.7 6.3 6 6c.3-.3.6-.4.8-.4h.6c.2 0 .5-.1.7.5l.9 2.2c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.3 1.2 2.4 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.1c.2-.3.5-.3.8-.2l2.3 1.1c.3.2.5.3.6.4.1.2.1.9-.3 1.6Z"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" class="size-6 text-[#25d366]" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 3 1.3 3 .9 3.5.8.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.5-.4ZM12 21.8h0a9.7 9.7 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.8 9.8 0 1 1 8.3 4.6Zm0-21.6a11.8 11.8 0 0 0-10.2 17.7L.2 23.5a.6.6 0 0 0 .7.7l5.8-1.5A11.8 11.8 0 1 0 12 .2Z"/></svg>
            )}
            <p class="mt-3 font-[family-name:var(--font-display)] text-sm font-bold text-body">{ch.label}</p>
            <p class="mt-0.5 text-sm text-muted">{ch.value}</p>
          </>
        );
        return (
          <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
            {ch.href ? (
              <a href={ch.href} class="card flex h-full flex-col items-center p-5 text-center transition-transform hover:-translate-y-1">{Inner}</a>
            ) : (
              <div class="card flex h-full flex-col items-center p-5 text-center">{Inner}</div>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <!-- form + map -->
  <section class="container-site section grid gap-10 lg:grid-cols-2 lg:gap-14">
    <div class="reveal">
      <h2 class="text-2xl font-bold text-body md:text-3xl">{c.formTitle}</h2>
      <div class="mt-6">
        <ContactForm locale={locale} client:visible />
      </div>
    </div>

    <div class="reveal" style="--reveal-delay:120ms">
      <h2 class="text-2xl font-bold text-body md:text-3xl">{c.addressTitle}</h2>
      <p class="mt-4 flex items-start gap-2.5 text-muted">
        <MapPin class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" />
        {site.address[locale]}
      </p>
      <div class="card mt-5 overflow-hidden">
        <iframe
          src={site.mapsEmbed}
          title={c.addressTitle}
          width="100%"
          height="320"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="mt-5 text-xs text-muted">{site.legal[locale]} · {site.license[locale]}</p>

      <div class="card mt-6 flex flex-col items-start gap-3 bg-accent/8 p-6">
        <p class="font-[family-name:var(--font-display)] font-bold text-body">{c.crossSell}</p>
        <a href={r(locale, "oferta")} class="btn btn-primary">{c.crossCta}<ArrowRight class="size-4" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
