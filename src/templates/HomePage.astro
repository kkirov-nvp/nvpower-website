---
import { ArrowRight, Check, Zap, Sun, FileText, PenLine, Wrench, BadgeCheck, UserRound, Landmark, BatteryCharging, LifeBuoy, Flag, MapPin, Battery, PiggyBank } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import MiniConfigurator from "../islands/MiniConfigurator";
import type { Locale } from "../config/site";
import { site } from "../config/site";
import { useUI, r } from "../i18n/ui";
import { featuredProjects, segmentLabels } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useUI(locale);

const c = {
  bg: {
    title: "NV Power — Енергия за утрешния ден | Ток и соларни системи",
    description:
      "Ток на ясна цена — 0.099 €/кВтч (0.194 лв./кВтч) — и соларни централи с батерии и гъвкаво финансиране. Вземи оферта за 2 минути.",
    hero: {
      h1: "Енергия за утрешния ден",
      sub: `Ток на ясна цена — ${site.price.display.bg} — и соларни централи с батерии, с гъвкаво финансиране. Двете решения, един партньор: NV Power.`,
      ctaCalc: "Изчисли спестяванията",
      ctaOffer: "Вземи оферта",
      checks: [t.promises.noFees, t.promises.response, t.promises.financing],
    },
    lines: {
      eyebrow: "Двете направления",
      title: "Ток днес. Собствена енергия утре.",
      lead: "Купуваш ток на ясна цена днес и изграждаш собствена централа с лизинг утре — при един и същ партньор.",
      tok: {
        title: "Ток за твоя бизнес и дом",
        price: site.price.display.bg,
        priceNote: "публична цена, без скрити такси",
        points: ["Смяната е безплатна и без прекъсване", "Без депозити и без обвързващи изненади", "Личен консултант, а не кол център"],
        cta: "Виж плановете",
      },
      solar: {
        title: "Твоята соларна централа",
        badge: "с батерия и финансиране",
        points: ["От проект до пускане — всичко от нас", "Батерии за истинска независимост", "Лизинг и разсрочено плащане"],
        cta: "Разгледай решенията",
      },
    },
    quiz: {
      eyebrow: "Мини конфигуратор",
      title: "Не знаеш откъде да започнеш?",
      lead: "Отговори на 3 кратки въпроса и ще ти покажем най-подходящото решение — за секунди, без данни за контакт.",
    },
    how: {
      eyebrow: "Как работи",
      title: "Три стъпки до по-добра енергия",
      steps: [
        { icon: FileText, title: "Изпращаш запитване", text: "Онлайн за 2 минути — или ни се обаждаш директно." },
        { icon: PenLine, title: `Получаваш оферта до 1 работен ден`, text: "Конкретни числа за твоя обект, без ангажимент." },
        { icon: Wrench, title: "Договор онлайн / монтаж", text: "Смяната на доставчик е дистанционна; централата изграждаме до ключ." },
      ],
    },
    why: {
      eyebrow: "Защо NV Power",
      title: "Партньор, който мисли за твоята независимост",
      cards: [
        { icon: BadgeCheck, title: "Прозрачна цена", text: `Публикуваме цената си — ${site.price.display.bg} — и я спазваме. Без скрити такси.` },
        { icon: UserRound, title: "Личен консултант", text: "Един човек познава обекта ти и отговаря — по телефон, имейл или Viber." },
        { icon: Landmark, title: "Възможност за финансиране", text: "Лизинг и разсрочено плащане за соларни системи и батерии — започваш без голяма инвестиция." },
        { icon: BatteryCharging, title: "Батерии и независимост", text: "Проектираме хибридни системи, които работят и когато мрежата не работи." },
        { icon: LifeBuoy, title: "Поддръжка и мониторинг", text: "Следим системата ти и реагираме, преди да усетиш проблем." },
        { icon: Flag, title: "Българска компания", text: "Местен екип, местни решения и договори на разбираем български език." },
      ],
    },
    projects: {
      eyebrow: "Проекти",
      title: "Реални системи, реални икономии",
      seeAll: "Виж всички проекти",
      specs: { power: "Мощност", battery: "Батерия", location: "Локация", savings: "Икономия" },
      empty: "Скоро публикуваме първите си реализирани проекти — с реални числа и снимки.",
    },
    faq: {
      eyebrow: "Въпроси",
      title: "Питаш се…",
      more: "Виж всички въпроси и отговори",
      items: [
        { q: "Смяната на доставчика ще прекъсне ли тока ми?", a: "Не. Смяната е чисто административна — токът ти тече по същите жици, без нито секунда прекъсване. Сменя се само този, който ти издава фактурата." },
        { q: "Колко струва смяната на доставчик?", a: "Нищо. Смяната е безплатна, без такси и без депозити. Поемаме цялата административна процедура вместо теб." },
        { q: "Колко струва соларна система за дом?", a: "Типична система от 10 kWp с батерия за къща се изплаща за 5–7 години — а с нашето финансиране започваш без голяма първоначална инвестиция. Точното число ще ти дадем в офертата." },
        { q: "Какво прави батерията и трябва ли ми?", a: "Батерията съхранява произведената през деня енергия, за да я ползваш вечер — и те пази при спиране на тока. Ако целта ти е независимост, батерията е разликата." },
        { q: "Какво е балансираща група?", a: "Обединение на потребители, чиито отклонения в потреблението взаимно се компенсират. Като член на нашата група плащаш по-малко за небаланси — включването е автоматично с договора." },
      ],
    },
  },
  en: {
    title: "NV Power — Energy for tomorrow | Electricity & solar systems",
    description:
      "Electricity at a clear price — €0.099/kWh (0.194 BGN/kWh) — and solar plants with batteries and flexible financing. Get a quote in 2 minutes.",
    hero: {
      h1: "Energy for tomorrow",
      sub: `Electricity at a clear price — ${site.price.display.en} — and solar plants with batteries and flexible financing. Two solutions, one partner: NV Power.`,
      ctaCalc: "Calculate your savings",
      ctaOffer: "Get a quote",
      checks: [t.promises.noFees, t.promises.response, t.promises.financing],
    },
    lines: {
      eyebrow: "Two business lines",
      title: "Power today. Your own energy tomorrow.",
      lead: "Buy electricity at a clear price today and build your own plant on leasing tomorrow — with the same partner.",
      tok: {
        title: "Electricity for your business & home",
        price: site.price.display.en,
        priceNote: "published price, no hidden fees",
        points: ["Switching is free, with no interruption", "No deposits, no contract surprises", "A personal consultant, not a call centre"],
        cta: "See the plans",
      },
      solar: {
        title: "Your own solar plant",
        badge: "with battery & financing",
        points: ["From design to launch — all by us", "Batteries for true independence", "Leasing and instalment plans"],
        cta: "Explore the solutions",
      },
    },
    quiz: {
      eyebrow: "Mini configurator",
      title: "Not sure where to start?",
      lead: "Answer 3 short questions and we'll show you the best fit — in seconds, no contact details needed.",
    },
    how: {
      eyebrow: "How it works",
      title: "Three steps to better energy",
      steps: [
        { icon: FileText, title: "Send an enquiry", text: "Online in 2 minutes — or just call us." },
        { icon: PenLine, title: `Get a quote within 1 business day`, text: "Real numbers for your site, no commitment." },
        { icon: Wrench, title: "Contract online / installation", text: "Supplier switching is remote; we build plants turnkey." },
      ],
    },
    why: {
      eyebrow: "Why NV Power",
      title: "A partner focused on your independence",
      cards: [
        { icon: BadgeCheck, title: "Transparent price", text: `We publish our price — ${site.price.display.en} — and we honour it. No hidden fees, guaranteed.` },
        { icon: UserRound, title: "Personal consultant", text: "One person knows your site and answers — by phone, email or Viber." },
        { icon: Landmark, title: "Financing available", text: "Leasing and instalments for solar systems and batteries — start without a big investment." },
        { icon: BatteryCharging, title: "Batteries & independence", text: "We design hybrid systems that keep working when the grid doesn't." },
        { icon: LifeBuoy, title: "Support & monitoring", text: "We watch your system and react before you notice a problem." },
        { icon: Flag, title: "A Bulgarian company", text: "A local team, local solutions and contracts in plain language." },
      ],
    },
    projects: {
      eyebrow: "Projects",
      title: "Real systems, real savings",
      seeAll: "See all projects",
      specs: { power: "Capacity", battery: "Battery", location: "Location", savings: "Savings" },
      empty: "We'll publish our first completed projects soon — with real numbers and photos.",
    },
    faq: {
      eyebrow: "Questions",
      title: "You're wondering…",
      more: "See all questions & answers",
      items: [
        { q: "Will switching supplier interrupt my power?", a: "No. Switching is purely administrative — your power flows through the same wires without a second of interruption. Only the company issuing your invoice changes." },
        { q: "How much does switching cost?", a: "Nothing. Switching is free — no fees, no deposits. We handle the whole administrative procedure for you." },
        { q: "How much does a home solar system cost?", a: "A typical 10 kWp system with a battery pays for itself in 5–7 years — and with our financing you start without a big upfront investment. You'll get the exact number in your quote." },
        { q: "What does the battery do — do I need one?", a: "The battery stores the energy produced during the day so you can use it in the evening — and keeps you running during outages. If independence is your goal, the battery is the difference." },
        { q: "What is a balancing group?", a: "A pool of consumers whose deviations offset each other. As a member of our group you pay less for imbalances — joining is automatic with your contract." },
      ],
    },
  },
}[locale];
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/">
  <!-- 1 ▸ HERO — full-width image with overlay, centered text -->
  <section class="relative -mt-16 flex min-h-[560px] items-center overflow-hidden md:-mt-20 md:min-h-[640px]">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/hero.svg');"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-charcoal/45" aria-hidden="true"></div>

    <div class="container-site relative py-24 pt-40 text-center md:pt-44">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl md:text-6xl md:leading-[1.08]">
        {c.hero.h1}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">{c.hero.sub}</p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={r(locale, "kalkulator")} class="btn btn-primary !px-7 !py-4 text-base">
          {c.hero.ctaCalc}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href={r(locale, "oferta")} class="btn btn-ghost-band !px-7 !py-4 text-base">{c.hero.ctaOffer}</a>
      </div>

      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5">
        {c.hero.checks.map((check) => (
          <li class="flex items-center gap-2 text-sm font-medium text-white/90">
            <Check class="size-4 text-[#6fd0da]" aria-hidden="true" />
            {check}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TWO BUSINESS LINES -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.lines.eyebrow} title={c.lines.title} lead={c.lines.lead} />

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- Ток -->
      <article class="reveal card flex flex-col gap-5 p-8 md:p-10">
        <span class="flex size-13 items-center justify-center rounded-xl bg-accent/10 text-accent"><Zap class="size-6.5" aria-hidden="true" /></span>
        <h3 class="text-2xl font-bold text-body">{c.lines.tok.title}</h3>
        <p class="font-[family-name:var(--font-display)]">
          <span class="text-4xl font-bold text-accent">{c.lines.tok.price.split(" ")[0]}</span>
          <span class="ml-1 text-lg font-semibold text-muted">{c.lines.tok.price.split(" ").slice(1).join(" ")}</span>
          <span class="mt-1 block text-sm font-medium text-muted">{c.lines.tok.priceNote}</span>
        </p>
        <ul class="flex flex-col gap-2.5">
          {c.lines.tok.points.map((p) => (
            <li class="flex items-start gap-2.5 text-[0.95rem] text-body">
              <Check class="mt-0.5 size-4 shrink-0 text-accent" aria-hidden="true" />{p}
            </li>
          ))}
        </ul>
        <a href={r(locale, "tok")} class="btn btn-primary mt-auto self-start">{c.lines.tok.cta}<ArrowRight class="size-4" aria-hidden="true" /></a>
      </article>

      <!-- Солар -->
      <article class="reveal card flex flex-col gap-5 p-8 md:p-10" style="--reveal-delay:100ms">
        <span class="flex size-13 items-center justify-center rounded-xl bg-accent/10 text-accent"><Sun class="size-6.5" aria-hidden="true" /></span>
        <h3 class="text-2xl font-bold text-body">{c.lines.solar.title}</h3>
        <p><span class="inline-flex rounded-full bg-accent/10 px-3.5 py-1.5 text-sm font-semibold text-accent">{c.lines.solar.badge}</span></p>
        <ul class="flex flex-col gap-2.5">
          {c.lines.solar.points.map((p) => (
            <li class="flex items-start gap-2.5 text-[0.95rem] text-body">
              <Check class="mt-0.5 size-4 shrink-0 text-accent" aria-hidden="true" />{p}
            </li>
          ))}
        </ul>
        <a href={r(locale, "solar")} class="btn btn-outline mt-auto self-start">{c.lines.solar.cta}<ArrowRight class="size-4" aria-hidden="true" /></a>
      </article>
    </div>
  </section>

  <!-- 4 ▸ MINI-CONFIGURATOR -->
  <section class="bg-surface-alt">
    <div class="container-site section">
      <SectionHeading eyebrow={c.quiz.eyebrow} title={c.quiz.title} lead={c.quiz.lead} />
      <div class="reveal mt-10">
        <MiniConfigurator locale={locale} client:visible />
      </div>
    </div>
  </section>

  <!-- 5 ▸ HOW IT WORKS -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.how.eyebrow} title={c.how.title} />
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {c.how.steps.map((s, i) => (
        <li class="reveal card relative p-7" style={`--reveal-delay:${i * 90}ms`}>
          <span class="absolute top-6 right-6 font-[family-name:var(--font-display)] text-5xl font-bold text-line">{String(i + 1).padStart(2, "0")}</span>
          <span class="flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent"><s.icon class="size-6" aria-hidden="true" /></span>
          <h3 class="mt-4 text-lg font-bold text-body">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 6 ▸ WHY NV POWER -->
  <section class="bg-surface-alt">
    <div class="container-site section">
      <SectionHeading eyebrow={c.why.eyebrow} title={c.why.title} />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {c.why.cards.map((card, i) => (
          <li class="reveal card p-6" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="flex size-11 items-center justify-center rounded-xl bg-accent/10 text-accent"><card.icon class="size-5.5" aria-hidden="true" /></span>
            <h3 class="mt-3.5 font-[family-name:var(--font-display)] text-base font-bold text-body">{card.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{card.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7 ▸ FEATURED PROJECTS -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.projects.eyebrow} title={c.projects.title} />
    {featuredProjects.length === 0 ? (
      <p class="mx-auto mt-10 max-w-md text-center text-muted">{c.projects.empty}</p>
    ) : (
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {featuredProjects.map((p, i) => (
          <li class="reveal card overflow-hidden" style={`--reveal-delay:${i * 90}ms`}>
            <div class="flex h-36 items-center justify-center bg-linear-to-br from-[#00505c] to-[#007b88]">
              <Sun class="size-10 text-white/70" aria-hidden="true" />
            </div>
            <div class="p-6">
              <span class="inline-flex rounded-full bg-accent/10 px-3 py-1 text-xs font-bold text-accent">{segmentLabels[p.segment][locale]}</span>
              <h3 class="mt-3 font-[family-name:var(--font-display)] text-base font-bold text-body">{p.title[locale]}</h3>
              <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2.5 text-sm">
                <div class="flex items-center gap-2"><Zap class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.power}</dt><dd class="font-semibold text-body">{p.kwp} kWp</dd></div>
                <div class="flex items-center gap-2"><Battery class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.battery}</dt><dd class="font-semibold text-body">{p.batteryKwh ? `${p.batteryKwh} kWh` : "—"}</dd></div>
                <div class="flex items-center gap-2"><MapPin class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.location}</dt><dd class="text-muted">{p.location[locale]}</dd></div>
                <div class="flex items-center gap-2"><PiggyBank class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.savings}</dt><dd class="text-muted">{p.annualSavings[locale]}</dd></div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
    )}
    <div class="reveal mt-9 text-center">
      <a href={r(locale, "proekti")} class="btn btn-outline">{c.projects.seeAll}<ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>
  </section>

  <!-- FAQ TEASER -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.faq.eyebrow} title={c.faq.title} />
    <div class="reveal mx-auto mt-10 max-w-3xl">
      <FaqAccordion items={c.faq.items} />
      <p class="mt-6 text-center">
        <a href={r(locale, "info")} class="font-semibold text-accent underline decoration-2 underline-offset-4 hover:text-accent-hover">{c.faq.more}</a>
      </p>
    </div>
  </section>

  <!-- FINAL CTA BAND -->
  <CtaBand locale={locale} />
</BaseLayout>
