---
import { ArrowRight, Check, X, Zap, LineChart, Building2, FileSearch, PenLine, Repeat, Clock, BadgePercent, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import InvoiceUpload from "../islands/InvoiceUpload";
import type { Locale } from "../config/site";
import { site } from "../config/site";
import { r } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const c = {
  bg: {
    title: "Изкупуване на ток от ВЕИ производители | NV Power",
    description: `Продай тока си при ясни условия: NV Фиксиран (БНЕБ − 15 €/MWh), NV Standard или индивидуална оферта над 1 MW. Балансирането е включено.`,
    hero: {
      h1: "Продавай тока си. При ясни условия.",
      sub: "Лицензиран търговец на електроенергия. Изкупуваме продукцията на ВЕИ производители — с прозрачна формула и включено балансиране.",
      ctaPrimary: "Вземи оферта за 2 минути",
      ctaSecondary: "Виж плановете",
      checks: [`Отговор до 3 работни дни`, "Балансирането е включено", "Без депозити"],
    },
    plans: {
      eyebrow: "Планове",
      title: "Избери как да продаваш тока си",
      lead: "Три плана с ясна цена и договор — с постоянна комуникация с екипа ни през целия период.",
      note: "Всички планове включват участие в балансиращата ни група",
      noticeLabel: "Предизвестие",
      items: [
        {
          icon: Zap,
          badge: "Най-предсказуем",
          name: "NV Фиксиран",
          priceMain: "БНЕБ − 15 €",
          priceSub: "на MWh",
          term: "предизвестие само 1 месец",
          features: [
            "Предизвестие: само 1 месец — без дългосрочно обвързване",
            "Фиксирано балансиране",
            "Постоянна комуникация и поддръжка от търговския ни екип",
            "Идеален за малки и средни ВЕИ производители",
          ],
          cta: "Вземи оферта за NV Fixed",
        },
        {
          icon: LineChart,
          badge: "Най-популярен",
          name: "NV Standard",
          term: "две нива на гъвкавост",
          /* Two-component plan — the visitor picks a tier inside the card. */
          options: [
            {
              id: "flex",
              label: "Standard Flexible",
              formula: "БНЕБ − 5 €",
              notice: "3 месеца",
              hint: "По-кратък срок, повече свобода",
            },
            {
              id: "long",
              label: "Standard Дългосрочен",
              formula: "БНЕБ − 4 €",
              notice: "12 месеца",
              hint: "Най-добрата цена за стандартен план",
            },
          ],
          features: [
            "Избираш нивото на гъвкавост според планирания си хоризонт",
            "По-ниска такса за балансиране при по-дългосрочен договор",
            "Включено пълно управление на балансиращата група",
          ],
          cta: "Избери NV Standard",
        },
        {
          icon: Building2,
          badge: "За големи обекти (над 1 MW)",
          name: "NV Individual",
          priceMain: "По договаряне",
          priceSub: "спрямо производствения ти профил",
          term: "предизвестие по договор",
          features: [
            "Персонализирана оферта за производители с мощност над 1 MW",
            "Предизвестие: индивидуално спрямо договора",
            "Анализ на производствения профил преди офертата",
            "Личен акаунт мениджър и индивидуална търговска стратегия",
          ],
          cta: "Заяви индивидуална оферта",
        },
      ],
      /* B2B block under the cards — supply *and* buy-back above 1 MW. */
      b2b: {
        badge: "За обекти над 1 MW",
        title: "Продаваме ток и изготвяме индивидуални оферти",
        text: "Персонализирано изкупуване и доставка на електрическа енергия за консуматори и производители с мощност над 1 MW — разработени на база специфичния профил на производство и потребление.",
        cta: "Свържи се с нас",
      },
    },
    compare: {
      eyebrow: "Сравнение",
      title: "Плановете един до друг",
      lead: "Без звездички и дребен шрифт — това са условията.",
      cols: ["План", "Формула (БНЕБ)", "Срок на предизвестие", "Целева група", "Основно предимство"],
      rows: [
        { plan: "NV Фиксиран", formula: "БНЕБ − 15 €", notice: "1 месец", target: "Малки ВЕИ централи", advantage: "Пълна свобода с 1 месец предизвестие." },
        { plan: "NV Standard Flexible", formula: "БНЕБ − 5 €", notice: "3 месеца", target: "Средни ВЕИ", advantage: "Баланс между добра цена и кратък срок." },
        { plan: "NV Standard Дългосрочен", formula: "БНЕБ − 4 €", notice: "12 месеца", target: "Стабилни ВЕИ", advantage: "Максимална печалба с най-ниска такса за балансиране." },
        { plan: "NV Individual", formula: "По договаряне", notice: "По договаряне", target: "Обекти над 1 MW", advantage: "Условия, построени спрямо профила на обекта." },
      ],
    },
    switch: {
      eyebrow: "Започване",
      title: "Как започваш да продаваш при нас",
      lead: "Цялата процедура я движим ние — на теб ти остава да подпишеш.",
      steps: [
        { icon: FileSearch, title: "Изпращаш ни данните на централата", text: "Мощност, точка на присъединяване и профил на производство. Изготвяме конкретна оферта по формулата. Безплатно е." },
        { icon: PenLine, title: "Подписваш дистанционно", text: "Договор на разбираем български, подписан онлайн. Ние подаваме документите към мрежовия оператор и те включваме в балансиращата ни група." },
        { icon: Repeat, title: "От 1-во число продаваш при нас", text: "Смяната е чисто административна — производството ти тръгва към нашата балансираща група. Изцяло дистанционно." },
      ],
    },
    invoice: {
      eyebrow: "Провери сам",
      title: "Изпрати ни последното си отчитане — ще ти покажем разликата",
      lead: `Прикачи последната си фактура или отчет за произведена енергия и ще получиш сравнителна оферта до 3 работни дни — с конкретни числа, не с обещания.`,
    },
    faq: {
      eyebrow: "Въпроси",
      title: "Често питани въпроси",
      items: [
        { q: "Ще спре ли производството ми при смяна на купувача?", a: "Не, нито за секунда. Смяната е чисто административна — енергията тръгва по същата мрежа, поддържана от същия мрежов оператор. Променя се само търговецът, който изкупува продукцията ти." },
        { q: "Колко струва смяната и колко време отнема?", a: "Смяната е напълно безплатна — без такси, без депозити. Подаваме документите до 10-о число на месеца и от 1-во число на следващия вече продаваш при нас. Цялата администрация я поемаме ние." },
        { q: "Какво е балансиране и защо го споменавате?", a: "Всеки производител се отклонява от прогнозата си за производство и някой плаща тези небаланси. Като член на нашата балансираща група отклоненията се компенсират взаимно между членовете — при NV Фиксиран балансирането е включено в цената, без отделни редове изненади." },
        { q: "Как се формира цената, която получавам?", a: "По формулата на избрания план: борсовата цена на БНЕБ за съответния период минус договорената такса — например БНЕБ − 15 €/MWh при NV Фиксиран. Получаваш месечен отчет с пълна разбивка, без скрити удръжки." },
        { q: "Мога ли да се откажа, ако не съм доволен?", a: "Да, с предизвестието на плана ти — 1 месец при NV Фиксиран, 3 или 12 месеца при NV Standard. Без неустойки и без обвързващи клаузи." },
      ],
    },
  },
  en: {
    title: "Electricity buy-back for renewable producers | NV Power",
    description: `Sell your power on clear terms: NV Fixed (IBEX − €15/MWh), NV Standard or an individual offer above 1 MW. Balancing included.`,
    hero: {
      h1: "Sell your power. On clear terms.",
      sub: "A licensed electricity trader. We buy the output of renewable producers — a transparent formula with balancing included.",
      ctaPrimary: "Get a quote in 2 minutes",
      ctaSecondary: "See the plans",
      checks: [`Reply within 3 business days`, "Balancing included", "No deposits"],
    },
    plans: {
      eyebrow: "Plans",
      title: "Choose how you sell your power",
      lead: "Three plans with a clear price and a clear contract — and constant contact with our team throughout.",
      note: "Every plan includes membership in our balancing group",
      noticeLabel: "Notice period",
      items: [
        {
          icon: Zap,
          badge: "Most predictable",
          name: "NV Fixed",
          priceMain: "IBEX − €15",
          priceSub: "per MWh",
          term: "just 1 month's notice",
          features: [
            "Notice period: just 1 month — no long-term lock-in",
            "Fixed balancing",
            "Ongoing contact and support from our trading desk",
            "Ideal for small and mid-size renewable producers",
          ],
          cta: "Get an NV Fixed quote",
        },
        {
          icon: LineChart,
          badge: "Most popular",
          name: "NV Standard",
          term: "two levels of flexibility",
          /* Two-component plan — the visitor picks a tier inside the card. */
          options: [
            {
              id: "flex",
              label: "Standard Flexible",
              formula: "IBEX − €5",
              notice: "3 months",
              hint: "Shorter term, more freedom",
            },
            {
              id: "long",
              label: "Standard Long-term",
              formula: "IBEX − €4",
              notice: "12 months",
              hint: "The best price in the standard plan",
            },
          ],
          features: [
            "Choose the level of flexibility that matches your horizon",
            "A lower balancing fee on a longer contract",
            "Full balancing-group management included",
          ],
          cta: "Choose NV Standard",
        },
        {
          icon: Building2,
          badge: "For large sites (over 1 MW)",
          name: "NV Individual",
          priceMain: "Negotiated",
          priceSub: "based on your generation profile",
          term: "notice period set by contract",
          features: [
            "A tailored offer for producers with over 1 MW installed capacity",
            "Notice period: set individually in the contract",
            "Analysis of your generation profile before the offer",
            "A personal account manager and an individual trading strategy",
          ],
          cta: "Request an individual offer",
        },
      ],
      /* B2B block under the cards — supply *and* buy-back above 1 MW. */
      b2b: {
        badge: "For sites over 1 MW",
        title: "We sell power and build individual offers",
        text: "Bespoke buy-back and supply of electricity for consumers and producers above 1 MW — built around your specific generation and consumption profile.",
        cta: "Get in touch",
      },
    },
    compare: {
      eyebrow: "Comparison",
      title: "The plans side by side",
      lead: "No asterisks, no small print — these are the terms.",
      cols: ["Plan", "Formula (IBEX)", "Notice period", "Target group", "Key advantage"],
      rows: [
        { plan: "NV Fixed", formula: "IBEX − €15", notice: "1 month", target: "Small renewable plants", advantage: "Full freedom, one month's notice." },
        { plan: "NV Standard Flexible", formula: "IBEX − €5", notice: "3 months", target: "Mid-size renewables", advantage: "A balance of good price and a short commitment." },
        { plan: "NV Standard Long-term", formula: "IBEX − €4", notice: "12 months", target: "Established renewables", advantage: "Maximum return with the lowest balancing fee." },
        { plan: "NV Individual", formula: "Negotiated", notice: "Negotiated", target: "Sites over 1 MW", advantage: "Terms built around your site's profile." },
      ],
    },
    switch: {
      eyebrow: "Getting started",
      title: "How you start selling to us",
      lead: "We drive the whole procedure — all you do is sign.",
      steps: [
        { icon: FileSearch, title: "Send us your plant details", text: "Capacity, grid connection point and generation profile. We prepare a concrete offer on the formula. It's free." },
        { icon: PenLine, title: "Sign remotely", text: "A plain-language contract, signed online. We file the paperwork with the grid operator and add you to our balancing group." },
        { icon: Repeat, title: "From the 1st, you sell to us", text: "Purely administrative — your output starts flowing into our balancing group. Fully remote." },
      ],
    },
    invoice: {
      eyebrow: "Check for yourself",
      title: "Send us your latest settlement — we'll show you the difference",
      lead: `Attach your latest invoice or generation report and you'll get a comparative offer within 3 business days — with real numbers, not promises.`,
    },
    faq: {
      eyebrow: "Questions",
      title: "Frequently asked questions",
      items: [
        { q: "Will my generation stop when I change buyer?", a: "No, not for a second. The change is purely administrative — the energy flows through the same grid, maintained by the same grid operator. Only the trader purchasing your output changes." },
        { q: "How much does switching cost and how long does it take?", a: "Switching is completely free — no fees, no deposits. We file the documents by the 10th of the month and from the 1st of the next month you are selling to us. We handle all the administration." },
        { q: "What is balancing and why do you mention it?", a: "Every producer deviates from their generation forecast, and someone pays for those imbalances. As a member of our balancing group, deviations offset each other between members — on NV Fixed, balancing is included in the price, with no surprise line items." },
        { q: "How is the price I receive calculated?", a: "By your plan formula: the IBEX exchange price for the period minus the agreed fee — for example IBEX − €15/MWh on NV Fixed. You get a monthly report with a full breakdown and no hidden deductions." },
        { q: "Can I leave if I am not happy?", a: "Yes, on your plan notice period — 1 month on NV Fixed, 3 or 12 months on NV Standard. No penalties, no lock-in clauses." },
      ],
    },
  },
}[locale];
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/tok/">
  <!-- 1 ▸ HERO (dark band) -->
  <section class="bg-band">
    <div class="container-site py-16 text-center md:py-24">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl md:text-6xl md:leading-[1.05]">
        {c.hero.h1.split(".")[0]}.<br /><span class="text-[#6fd0da]">{c.hero.h1.split(".").slice(1).join(".").trim()}</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/75 md:text-lg">{c.hero.sub}</p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={r(locale, "oferta")} class="btn btn-primary !px-7 !py-4 text-base">
          {c.hero.ctaPrimary}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href="#planove" class="btn btn-ghost-band !px-7 !py-4 text-base">{c.hero.ctaSecondary}</a>
      </div>

      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5">
        {c.hero.checks.map((check) => (
          <li class="flex items-center gap-2 text-sm font-medium text-white/80">
            <Check class="size-4 text-[#6fd0da]" aria-hidden="true" />
            {check}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2 ▸ PLANS -->
  <section id="planove" class="section container-site">
    <SectionHeading eyebrow={c.plans.eyebrow} title={c.plans.title} lead={c.plans.lead} />

    <p class="reveal mx-auto mt-6 flex w-fit items-center gap-2.5 rounded-full bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent">
      <Check class="size-4 shrink-0" aria-hidden="true" />
      {c.plans.note}
    </p>

    <!-- 3-up only from xl: at md the cards are ~160px wide, too narrow for the
         tier boxes and it forces the plan title onto two lines -->
    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {c.plans.items.map((plan, i) => (
        <article
          class:list={["reveal card relative flex h-full flex-col gap-5 p-7 md:p-8", i === 1 && "border-accent ring-1 ring-accent"]}
          style={`--reveal-delay:${i * 90}ms`}
        >
          <span
            class:list={[
              "absolute -top-3.5 left-6 rounded-full px-3.5 py-1.5 text-xs font-bold",
              i === 1 ? "bg-accent text-accent-contrast" : "bg-accent/10 text-accent",
            ]}
          >
            {plan.badge}
          </span>

          <span class="mt-2 flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent">
            <plan.icon class="size-6" aria-hidden="true" />
          </span>
          <h3 class="text-xl font-bold text-body">
            {plan.name}
            {"options" in plan && plan.options && (
              <span class="text-xs font-medium text-muted"> ({plan.term})</span>
            )}
          </h3>

          {!("options" in plan && plan.options) && (
            <p class="font-[family-name:var(--font-display)]">
              <span class:list={["font-bold text-accent", i === 1 ? "text-4xl" : "text-3xl"]}>{plan.priceMain}</span>
              <span class="mt-1 block text-sm font-bold text-muted">{plan.priceSub}</span>
              <span class="mt-1 block text-sm font-medium text-accent">{plan.term}</span>
            </p>
          )}

          {"options" in plan && plan.options && (
            <div class="grid grid-cols-2 gap-2.5">
              {plan.options.map((opt) => (
                <div class="flex flex-col rounded-xl border border-line bg-surface-alt p-3">
                  <p class="text-[11px] leading-tight font-bold tracking-wide text-accent uppercase">{opt.label}</p>
                  <p class="mt-2 font-[family-name:var(--font-display)] text-base leading-none font-bold whitespace-nowrap text-accent">{opt.formula}</p>
                  <p class="mt-2 text-xs leading-snug font-semibold text-body">
                    {c.plans.noticeLabel}: <span class="whitespace-nowrap">{opt.notice}</span>
                  </p>
                  <p class="mt-1 text-[11px] leading-snug text-muted">{opt.hint}</p>
                </div>
              ))}
            </div>
          )}

          <ul class="flex flex-col gap-2.5">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2.5 text-sm text-body">
                <Check class="mt-0.5 size-4 shrink-0 text-accent" aria-hidden="true" />
                {f}
              </li>
            ))}
          </ul>

          <a href={r(locale, "oferta")} class:list={["btn mt-auto self-start", i === 1 ? "btn-primary" : "btn-outline"]}>
            {plan.cta}
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>

    <!-- B2B: supply and buy-back above 1 MW. Deliberately the loudest block on
         the page — it sits on the dark band surface the hero and CTA band use, so
         it separates hard from the white plan cards without new colours. -->
    <div
      class="reveal mt-10 overflow-hidden rounded-2xl bg-band-deep p-8 shadow-[0_18px_50px_-18px_rgb(13_47_51/0.55)] ring-1 ring-accent/40 md:p-10"
    >
      <div class="flex flex-col gap-7 md:flex-row md:items-center md:justify-between md:gap-10">
        <div class="flex items-start gap-5">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-accent text-accent-contrast">
            <Building2 class="size-7" aria-hidden="true" />
          </span>
          <div>
            <span
              class="inline-block rounded-full bg-accent px-3 py-1 font-[family-name:var(--font-display)] text-xs font-bold tracking-wide text-accent-contrast uppercase"
            >
              {c.plans.b2b.badge}
            </span>
            <h3 class="mt-3 font-[family-name:var(--font-display)] text-2xl font-bold text-white md:text-3xl">
              {c.plans.b2b.title}
            </h3>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-white/80">{c.plans.b2b.text}</p>
          </div>
        </div>
        <a href={r(locale, "kontakti")} class="btn btn-primary shrink-0 self-start !px-8 !py-4 text-base md:self-auto">
          {c.plans.b2b.cta}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3 ▸ COMPARISON TABLE -->
  <section class="bg-surface-alt">
    <div class="container-site section">
      <SectionHeading eyebrow={c.compare.eyebrow} title={c.compare.title} lead={c.compare.lead} />

      <div class="reveal card mt-10 overflow-x-auto">
        <table class="w-full min-w-[48rem] border-collapse text-sm">
          <thead>
            <tr class="bg-band text-left text-white">
              {c.compare.cols.map((col) => (
                <th scope="col" class="px-5 py-4 font-[family-name:var(--font-display)] font-bold md:px-6">{col}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {c.compare.rows.map((row) => (
              <tr class="odd:bg-surface even:bg-surface-alt/60">
                <th scope="row" class="px-5 py-3.5 text-left font-semibold text-body md:px-6">{row.plan}</th>
                <td class="px-5 py-3.5 font-[family-name:var(--font-display)] font-bold text-accent md:px-6">{row.formula}</td>
                <td class="px-5 py-3.5 text-muted md:px-6">{row.notice}</td>
                <td class="px-5 py-3.5 text-muted md:px-6">{row.target}</td>
                <td class="px-5 py-3.5 text-muted md:px-6">{row.advantage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4 ▸ HOW TO SWITCH -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.switch.eyebrow} title={c.switch.title} lead={c.switch.lead} />
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {c.switch.steps.map((s, i) => (
        <li class="reveal card relative p-7" style={`--reveal-delay:${i * 90}ms`}>
          <span class="absolute top-6 right-6 font-[family-name:var(--font-display)] text-5xl font-bold text-line">{String(i + 1).padStart(2, "0")}</span>
          <span class="flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent"><s.icon class="size-6" aria-hidden="true" /></span>
          <h3 class="mt-4 text-lg font-bold text-body">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 5 ▸ INVOICE UPLOAD (dark band) -->
  <section class="bg-band">
    <div class="container-site section">
      <SectionHeading eyebrow={c.invoice.eyebrow} title={c.invoice.title} lead={c.invoice.lead} on="band" />
      <ul class="mt-7 flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5">
        <li class="flex items-center gap-2 text-sm font-medium text-white/85"><Clock class="size-4 text-[#6fd0da]" aria-hidden="true" /> {locale === "bg" ? `Отговор до 3 работни дни` : `Reply within 3 business days`}</li>
        <li class="flex items-center gap-2 text-sm font-medium text-white/85"><BadgePercent class="size-4 text-[#6fd0da]" aria-hidden="true" /> {locale === "bg" ? "Без скрити такси" : "No hidden fees"}</li>
        <li class="flex items-center gap-2 text-sm font-medium text-white/85"><ShieldCheck class="size-4 text-[#6fd0da]" aria-hidden="true" /> {locale === "bg" ? "Без ангажимент" : "No commitment"}</li>
      </ul>
      <div class="reveal mx-auto mt-10 max-w-2xl">
        <InvoiceUpload locale={locale} client:visible />
      </div>
    </div>
  </section>

  <!-- 6 ▸ FAQ -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.faq.eyebrow} title={c.faq.title} />
    <div class="reveal mx-auto mt-10 max-w-3xl">
      <FaqAccordion items={c.faq.items} />
    </div>
  </section>

  <!-- 7 ▸ FINAL CTA BAND -->
  <CtaBand locale={locale} />
</BaseLayout>

