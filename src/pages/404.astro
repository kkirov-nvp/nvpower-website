---
import { House, Zap, Phone } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

// Single 404 for the whole site (static hosts serve /404.html for any miss).
// BG-primary with an EN line, since we can't know the visitor's language here.
---

<BaseLayout
  locale="bg"
  title="Страницата не е намерена — NV Power"
  description="Страницата, която търсиш, не съществува. Върни се към началото или вземи оферта за 2 минути."
  path="/404/"
  noindex
>
  <section class="container-site section flex min-h-[55vh] flex-col items-center justify-center text-center">
    <p class="font-[family-name:var(--font-display)] text-7xl font-bold text-accent md:text-8xl">404</p>
    <h1 class="mt-4 text-2xl font-bold text-body md:text-4xl">Тази страница не съществува</h1>
    <p class="mx-auto mt-3 max-w-md text-muted">
      Може линкът да е стар или сгрешен. Токът обаче тече — избери накъде:
    </p>
    <p class="mt-1 text-sm text-muted/80">This page doesn't exist — <a href="/en/" class="text-accent underline">continue in English</a>.</p>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary"><House class="size-4" aria-hidden="true" /> Към началото</a>
      <a href="/oferta/" class="btn btn-outline"><Zap class="size-4" aria-hidden="true" /> Вземи оферта</a>
      <a href={`tel:${site.phoneHref}`} class="btn btn-outline"><Phone class="size-4" aria-hidden="true" /> {site.phone}</a>
    </div>
  </section>
</BaseLayout>
