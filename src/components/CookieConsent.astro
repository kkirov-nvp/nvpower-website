---
import type { Locale } from "../config/site";
import { site } from "../config/site";
import { useUI, r } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useUI(locale);
---

<!-- Google Consent Mode v2 banner + settings modal (§3) -->
<div
  id="cc-banner"
  hidden
  class="fixed inset-x-3 bottom-20 z-60 mx-auto max-w-xl rounded-2xl border border-line bg-surface p-5 shadow-[0_20px_60px_-15px_rgb(13_47_51/0.4)] md:bottom-5"
  role="dialog"
  aria-label={t.consent.title}
>
  <h2 class="font-[family-name:var(--font-display)] text-base font-bold text-body">{t.consent.title}</h2>
  <p class="mt-1.5 text-sm leading-relaxed text-muted">
    {t.consent.text}
    <a href={r(locale, "privacy")} class="font-medium text-accent underline">{t.consent.privacyLink}</a>
  </p>

  <div id="cc-settings" hidden class="mt-4 flex flex-col gap-3">
    <label class="flex items-start gap-3 rounded-xl bg-surface-alt p-3 text-sm">
      <input type="checkbox" checked disabled class="mt-0.5 size-4 accent-[#007b88]" />
      <span><strong class="text-body">{t.consent.necessary}</strong><br /><span class="text-muted">{t.consent.necessaryText}</span></span>
    </label>
    <label class="flex items-start gap-3 rounded-xl bg-surface-alt p-3 text-sm">
      <input id="cc-analytics" type="checkbox" class="mt-0.5 size-4 accent-[#007b88]" />
      <span><strong class="text-body">{t.consent.analytics}</strong><br /><span class="text-muted">{t.consent.analyticsText}</span></span>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <button id="cc-accept" type="button" class="btn btn-primary !py-2.5 text-sm">{t.consent.acceptAll}</button>
    <button id="cc-reject" type="button" class="btn btn-outline !py-2.5 text-sm">{t.consent.rejectAll}</button>
    <button id="cc-toggle" type="button" class="btn !py-2.5 text-sm text-muted underline">{t.consent.settings}</button>
    <button id="cc-save" type="button" hidden class="btn btn-outline !py-2.5 text-sm">{t.consent.save}</button>
  </div>
</div>

<script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
  (function () {
    var KEY = "nvpower-consent";
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;

    // Consent Mode v2 defaults: everything denied until the user chooses.
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
    });

    function apply(analytics) {
      gtag("consent", "update", { analytics_storage: analytics ? "granted" : "denied" });
      if (analytics && gaId && !document.getElementById("ga4-src")) {
        var s = document.createElement("script");
        s.id = "ga4-src";
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
        document.head.appendChild(s);
        gtag("js", new Date());
        gtag("config", gaId, { anonymize_ip: true });
      }
    }

    var saved = null;
    try { saved = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) {}
    if (saved) { apply(!!saved.analytics); return; }

    var banner = document.getElementById("cc-banner");
    if (!banner) return;
    banner.hidden = false;

    function decide(analytics) {
      try { localStorage.setItem(KEY, JSON.stringify({ analytics: analytics, ts: Date.now() })); } catch (e) {}
      apply(analytics);
      banner.hidden = true;
    }

    document.getElementById("cc-accept").addEventListener("click", function () { decide(true); });
    document.getElementById("cc-reject").addEventListener("click", function () { decide(false); });
    document.getElementById("cc-toggle").addEventListener("click", function () {
      document.getElementById("cc-settings").hidden = false;
      document.getElementById("cc-save").hidden = false;
      this.hidden = true;
    });
    document.getElementById("cc-save").addEventListener("click", function () {
      decide(document.getElementById("cc-analytics").checked);
    });
  })();
</script>
