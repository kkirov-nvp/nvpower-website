{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; frame-src https://www.google.com; connect-src 'self' https://www.google-analytics.com; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/en/tok", "destination": "/en/electricity/", "permanent": true },
    { "source": "/en/oferta", "destination": "/en/request-a-quote/", "permanent": true },
    { "source": "/en/kalkulator", "destination": "/en/calculator/", "permanent": true },
    { "source": "/en/proekti", "destination": "/en/projects/", "permanent": true },
    { "source": "/en/za-nas", "destination": "/en/about/", "permanent": true },
    { "source": "/en/info", "destination": "/en/resources/", "permanent": true },
    { "source": "/en/kontakti", "destination": "/en/contact/", "permanent": true },
    { "source": "/en/politika-poveritelnost", "destination": "/en/privacy/", "permanent": true },
    { "source": "/en/obshti-usloviya", "destination": "/en/terms/", "permanent": true },
    { "source": "/en/solar/za-doma", "destination": "/en/solar/residential/", "permanent": true },
    { "source": "/en/solar/za-biznesa", "destination": "/en/solar/for-business/", "permanent": true }
  ]
}
